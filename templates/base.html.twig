<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Galerie Photo{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { min-height: 100vh; display: flex; flex-direction: column; }
        main { flex: 1; }
        .photo-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; overflow-x: auto; }
        .photo-card img { width: 100%; height: 150px; object-fit: cover; }
        .sidebar { min-width: 200px; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="{{ path('app_home') }}">Galerie Photo</a>
            <div class="d-flex align-items-center">
                {% if app.user %}
                    <span class="text-light me-3">{{ app.user.pseudo }}</span>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_admin') }}" class="btn btn-outline-warning btn-sm me-2">Admin</a>
                    {% else %}
                        <a href="{{ path('app_gallery') }}" class="btn btn-outline-light btn-sm me-2">Ma Galerie</a>
                    {% endif %}
                    <a href="{{ path('app_logout') }}" class="btn btn-outline-danger btn-sm">Déconnexion</a>
                {% else %}
                    <form action="{{ path('app_login') }}" method="post" class="d-flex gap-2">
                        <input type="email" name="_username" class="form-control form-control-sm" placeholder="E-mail" required>
                        <input type="password" name="_password" class="form-control form-control-sm" placeholder="Mot de passe" required>
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                        <button type="submit" class="btn btn-primary btn-sm">Connexion</button>
                        <a href="{{ path('app_register') }}" class="btn btn-outline-light btn-sm">Inscription</a>
                    </form>
                {% endif %}
            </div>
        </div>
    </nav>

    <div class="container mt-3">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}
    </div>

    <main class="container py-4">
        {% block body %}{% endblock %}
    </main>

    <footer class="bg-light py-3 mt-auto">
        <div class="container text-center text-muted">
            &copy; {{ "now"|date("Y") }} Galerie Photo
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
